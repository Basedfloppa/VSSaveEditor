<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:components="using:VSSaveEditor.Components"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:VSCore"
             x:Class="VSSaveEditor.Components.Tabs.ItemsTab">
    <!-- The "Items" tab: search across every inventory in the save - players, creatures and block entities.
         Matching stacks on the left, the card of the selected item on the right with a jump to its owner. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6">
            <TextBlock Text="Find item:" FontWeight="Bold" />
            <TextBox x:Name="ItemFilterBox" Width="300"
                     Watermark="diamond, owner:Moonlight, container:chest, count>=10, chunk:15991,15983…"
                     ToolTip.Tip="Free text over item code, owner, container, slot and item attributes. Prefixes: item:, owner:, container:, slot:, attr:, key:, chunk:, count&gt;=/&lt;=/&gt;/&lt;/=" />
            <ComboBox x:Name="ItemSourcePick" Width="145" SelectedIndex="0"
                      ToolTip.Tip="Narrow the search to players, creatures or block-entity containers">
                <ComboBoxItem Content="All sources" />
                <ComboBoxItem Content="Players" />
                <ComboBoxItem Content="Creatures" />
                <ComboBoxItem Content="Containers" />
            </ComboBox>
            <Button x:Name="ItemClearBtn" Content="Clear" Padding="8,2" />
            <Button x:Name="ItemChunkBtn" Content="This chunk" Padding="8,2"
                    ToolTip.Tip="Only items whose container/owner is in the chunk currently shown on the map" />
            <TextBlock x:Name="ItemSummaryLabel" MaxWidth="330" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextAccentBrush}" />
            <Button x:Name="CopyItemsBtn" Content="Copy list" Padding="8,2"
                    ToolTip.Tip="Copy the stacks currently shown" />
        </StackPanel>
        <components:ScopeBar x:Name="Scope" DockPanel.Dock="Top" />
        <!-- List on the left, card on the right; the 2:3 ratio starts with the card wider than the list.
             The divider can be dragged with the GridSplitter. -->
        <Grid x:Name="ItemLayoutGrid" ColumnDefinitions="2*,5,3*" Margin="6">
            <ListBox x:Name="ItemList" Grid.Column="0" MinWidth="220"
                     FontSize="{StaticResource MonoFontSize}"
                     FontFamily="{StaticResource MonoFontFamily}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="core:ItemStackRow">
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter x:Name="ItemSplitter" Grid.Column="1" Width="5"
                          Background="{DynamicResource CardBorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ToolTip.Tip="Drag to resize the item list" />
            <Grid x:Name="ItemDetailHost" Grid.Column="2" MinWidth="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Styles>
                        <!-- Long codes and owner strings wrap instead of being clipped on the right. -->
                        <Style Selector="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </ScrollViewer.Styles>
                    <StackPanel x:Name="ItemDetailPanel" Spacing="4" Margin="10,0,0,0" />
                </ScrollViewer>
                <!-- The empty state sits in the centre of the panel, not as a line in its top-left corner. -->
                <TextBlock x:Name="ItemEmptyHint" IsVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="460" Margin="20"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
