<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:components="using:VSSaveEditor.Components"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:VSCore"
             x:Class="VSSaveEditor.Components.Tabs.EntitiesTab">
    <!-- The "Entities" tab: a flat list of all creatures and block entities in the save instead of the text dump.
         Matches on the left, the card of the selected record on the right, with the same field editor as in a chunk. -->
    <DockPanel>
        <!-- Grid, not StackPanel: the summary is the only cell allowed to shrink, so the buttons stay inside
             the drawer at its narrowest checked width (`uisnap enttoolbar` measures this row at 960 and 1280). -->
        <Grid DockPanel.Dock="Top" Margin="6" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
            <TextBlock Grid.Column="0" Text="Find:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" x:Name="EntityFilterBox" Width="260" Margin="0,0,6,0"
                     Watermark="wolf, chest, onHurt, maxhealth…"
                     ToolTip.Tip="Matches the species/type, the kind and sex-age, the code list, the parsed field names and values" />
            <ComboBox Grid.Column="2" x:Name="EntityCategoryPick" Width="150" SelectedIndex="0" Margin="0,0,6,0"
                      ToolTip.Tip="Which records to list: everything, only creatures (field 6) or only block entities (field 8)">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Entities" />
                <ComboBoxItem Content="Block entities" />
            </ComboBox>
            <Button Grid.Column="3" x:Name="EntityClearBtn" Content="Clear" Padding="8,2" Margin="0,0,6,0" />
            <!-- Trimming keeps a long summary from pushing the buttons out; MaxWidth keeps it from swallowing the row -->
            <TextBlock Grid.Column="4" x:Name="EntitySummaryLabel" MaxWidth="360" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{DynamicResource TextAccentBrush}" />
            <Button Grid.Column="5" x:Name="EntityDataBtn" Content="Entity data…" Padding="8,2" Margin="0,0,6,0"
                    ToolTip.Tip="Everything saved for one record — its fields, its inventories and a trader's trade offers: edit values, delete items and offers" />
            <Button Grid.Column="6" x:Name="CopyListBtn" Content="Copy list" Padding="8,2" Margin="0,0,6,0"
                    ToolTip.Tip="Copy the rows currently shown" />
            <Button Grid.Column="7" x:Name="CopyDumpBtn" Content="Copy raw dump" Padding="8,2"
                    ToolTip.Tip="Copy the full text dump of the save (same as before: tables, histograms, regions, raw blobs)" />
        </Grid>
        <components:ScopeBar x:Name="Scope" DockPanel.Dock="Top" />
        <!-- Common names: you see at a glance what exists in the world, and one click sends it to the filter -->
        <WrapPanel x:Name="EntityChipsPanel" DockPanel.Dock="Top" Margin="6,0,6,4" />
        <!-- List on the left, card on the right; the 2:3 ratio starts with the card wider than the list.
             The divider can be dragged with the GridSplitter. -->
        <Grid x:Name="EntityLayoutGrid" ColumnDefinitions="2*,5,3*" Margin="6">
            <ListBox x:Name="EntityList" Grid.Column="0" MinWidth="220"
                     FontSize="{StaticResource MonoFontSize}"
                     FontFamily="{StaticResource MonoFontFamily}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="core:EntityRow">
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter x:Name="EntitySplitter" Grid.Column="1" Width="5"
                          Background="{DynamicResource CardBorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ToolTip.Tip="Drag to resize the entity list" />
            <Grid x:Name="EntityDetailHost" Grid.Column="2" MinWidth="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Styles>
                        <!-- Long codes of mod entities wrap instead of being clipped on the right. -->
                        <Style Selector="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </ScrollViewer.Styles>
                    <StackPanel x:Name="EntityDetailPanel" Spacing="4" Margin="10,0,0,0" />
                </ScrollViewer>
                <!-- The empty state sits in the centre of the panel, not as a line in its top-left corner. -->
                <TextBlock x:Name="EntityEmptyHint" IsVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="460" Margin="20"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
