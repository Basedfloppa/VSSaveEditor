<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:VSCore"
             x:Class="VSSaveEditor.Components.Tabs.WorldTab">
    <!-- The "World" tab: metadata of the open save (version, seed, size, world time) and the world tree -
         the settings the save itself carries (gameMode, daysPerMonth, landformScale, …) plus the mod entries
         stored beside them. The tree is editable: a value is changed in a dialog and travels the ordinary
         pending-edit path, so nothing is written before "Review & apply…".

         Layout follows the job: the list is what the user came for, so it gets the height; the save metadata
         collapses to one line; and the value card only takes width when a setting is picked (before that the
         list owns the row). The tab lives in a drawer that is often only ~170 px tall, so every row spent on
         chrome is a row the list does not get. -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="8,8,8,6">
            <TextBlock Grid.Column="0" Text="Find setting" VerticalAlignment="Center" Margin="0,0,6,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Grid.Column="1" x:Name="WorldFilterBox" VerticalContentAlignment="Center"
                     Watermark="name or value — gameMode, landform, creative…"
                     ToolTip.Tip="Free text over the setting name and its value (Esc clears)">
                <TextBox.InnerRightContent>
                    <Button x:Name="WorldClearBtn" Content="✕" IsVisible="False" Padding="4,0" Margin="0,0,2,0"
                            Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="Clear the filter (Esc)" />
                </TextBox.InnerRightContent>
            </TextBox>
            <Button Grid.Column="2" x:Name="CopyWorldBtn" Content="Copy list" Padding="8,2" Margin="10,0,0,0"
                    ToolTip.Tip="Copy every setting shown as name = value" />
        </Grid>

        <!-- The save metadata is context, not the task: one line while closed, the full block when opened.
             A flat ToggleButton, not an Expander: the Fluent Expander header carries a 32 px chevron and a
             40-48 px minimum, which is a third of the whole tab. -->
        <ToggleButton x:Name="WorldInfoToggle" DockPanel.Dock="Top" IsChecked="False" Margin="8,0,8,0"
                      Padding="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand"
                      ToolTip.Tip="World time, coordinates, relief, tables and gamedata size">
            <TextBlock x:Name="WorldInfoHeader" FontSize="11" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </ToggleButton>
        <TextBlock x:Name="MetaText" DockPanel.Dock="Top" IsVisible="False" TextWrapping="Wrap"
                   Margin="8,2,8,2" Foreground="{DynamicResource TextSecondaryBrush}" />

        <!-- One always-present line carries both the count and what to do next: it changes text, never height,
             so picking a row does not shift the list under the pointer. -->
        <TextBlock x:Name="WorldStatusLabel" DockPanel.Dock="Top" Margin="8,2,8,4" FontSize="11"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Click a setting to see its full value." />

        <Grid x:Name="WorldBody" ColumnDefinitions="*,5,0" Margin="8,0,8,8">
            <ListBox x:Name="WorldList" Grid.Column="0" MinWidth="240" Padding="0,2"
                     FontSize="{StaticResource MonoFontSize}"
                     FontFamily="{StaticResource MonoFontFamily}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4,1" />
                        <Setter Property="MinHeight" Value="20" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="core:WorldSetting">
                        <!-- Two aligned columns: the names form a readable edge and the values line up,
                             which dense "name = value" strings do not. The third column is the pending marker:
                             it appears only on rows a pending edit changes, so the list stays quiet. -->
                        <!-- 14 px on the right keeps the marker clear of the list's scrollbar, which overlays the row -->
                        <Grid ColumnDefinitions="190,*,Auto" Margin="0,0,14,0" ToolTip.Tip="{Binding Display}">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Preview}" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="• pending" Margin="8,0,0,0" FontSize="10"
                                       IsVisible="{Binding IsEdited}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter x:Name="WorldSplitter" Grid.Column="1" Width="5" IsVisible="False"
                          Background="{DynamicResource CardBorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ToolTip.Tip="Drag to resize the value card" />

            <!-- The card of the selected setting. Hidden until a row is picked: an empty panel would
                 reserve a third of the row for nothing, and a hint reads better as one line above the list. -->
            <Border x:Name="WorldDetailCard" Grid.Column="2" IsVisible="False" Margin="6,0,0,0" Padding="8"
                    BorderThickness="1" CornerRadius="4"
                    BorderBrush="{DynamicResource CardBorderBrush}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button x:Name="WorldCopyValueBtn" DockPanel.Dock="Right" Content="Copy value"
                                Padding="8,1" ToolTip.Tip="Copy the whole value (long blobs are cut in the list)" />
                        <Button x:Name="WorldEditBtn" DockPanel.Dock="Right" Content="Edit…" Margin="0,0,6,0"
                                Padding="8,1"
                                ToolTip.Tip="Change this value — it goes into pending edits, nothing is written until Review &amp; apply… (double-click a row does the same)" />
                        <TextBlock x:Name="WorldDetailName" FontWeight="Bold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock x:Name="WorldDetailMeta" DockPanel.Dock="Top" Margin="0,0,0,4" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <!-- Fills the card, so a 53 000-character mod blob scrolls here instead of living in a 140 px box. -->
                    <TextBox x:Name="WorldValueBox" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             FontFamily="{StaticResource MonoFontFamily}"
                             FontSize="{StaticResource MonoFontSize}" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
