# Local developer notes (not part of the public repository)
.dev-docs/

# Build output
bin/
obj/
*.user

# Local NuGet caches (the headless harness restores here)
.packages/
.httpcache/
.nuget/

# Runtime state written by the headless UI harness
.uisnap/VSSaveEditor/
.uisnap/bin/
.uisnap/obj/
.uisnap/.packages/
.uisnap/.httpcache/

# Agent/goal state - not part of the project
.pi/
.translate/
.work-translate/

# Local-only evidence: screenshots, probe logs, generated samples.
# These are regenerated by the app/tests and must never be committed.
artifacts/
*.log

# Saves and backups must never be committed
*.vcdbs
*.vcdbs-*
*.vcdbs.bak*
*.bak
*.bak-*
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Binary assets and archives are local-only.
# Build inputs are text files; see VSCore/BlockColors.txt and VSCore/ColorMaps.txt.
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.ico
*.webp
*.tif
*.tiff
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.nupkg
*.snupkg

# Compiled binaries outside build directories (bin/ and obj/ already cover normal builds)
*.dll
*.exe
*.pdb
*.so
*.dylib
*.a
*.lib
*.class
*.wasm

# OS / IDE
.DS_Store
Thumbs.db
.vs/
.vscode/
.idea/
*.swp
*~

# Python
__pycache__/
*.pyc
*.pyo

# Temporary files
*.tmp
*.temp
